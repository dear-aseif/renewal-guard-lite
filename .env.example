# Renewal Guard v2 — environment variables
# Copy to .env for local `vercel dev`, and set the same values in Vercel dashboard.

# --- Auth (single user) ---
# A strong password you will type to sign in. Minimum 12 characters.
APP_PASSWORD=change-me-to-a-long-random-password
# Random secret used to sign the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-hex-secret

# --- Turso (source of truth database) ---
# Found in your Turso dashboard under the database you created.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=change-me-to-your-turso-token

# --- Web Push (VAPID) ---
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
# A mailto: or https: contact for the push service. Example: mailto:you@example.com
VAPID_SUBJECT=mailto:you@example.com

# --- Cron protection ---
# Extra shared secret so only Vercel (and you) can trigger /api/cron.
CRON_SECRET=change-me-to-another-random-secret
